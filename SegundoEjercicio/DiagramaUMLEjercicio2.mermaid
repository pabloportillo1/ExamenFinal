classDiagram
    class ReportSystem {
      -reports_generated: list~dict~
      +generate_report(report_type: str, data: dict, output_format: str, delivery_method: str) str
      +get_report_history() list~dict~
    }

    class ReportGenerator {
      <<interface>>
      +generate(data: dict) str
    }

    class SalesReportGenerator {
      +generate(data: dict) str
    }

    class InventoryReportGenerator {
      +generate(data: dict) str
    }

    class FinancialReportGenerator {
      +generate(data: dict) str
    }

    class ReportFormatter {
      <<interface>>
      +format(content: str) str
    }

    class PDFFormatter {
      +format(content: str) str
    }

    class ExcelFormatter {
      +format(content: str) str
    }

    class HTMLFormatter {
      +format(content: str) str
    }

    class ReportDelivery {
      <<interface>>
      +deliver(content: str, report_type: str, output_format: str) void
    }

    class EmailDelivery {
      +deliver(content: str, report_type: str, output_format: str) void
    }

    class DownloadDelivery {
      +deliver(content: str, report_type: str, output_format: str) void
    }

    class CloudDelivery {
      +deliver(content: str, report_type: str, output_format: str) void
    }

    class ReportFactory {
      +get_generator(type: str) ReportGenerator
      +get_formatter(format: str) ReportFormatter
      +get_delivery(method: str) ReportDelivery
    }

    ReportGenerator <|.. SalesReportGenerator
    ReportGenerator <|.. InventoryReportGenerator
    ReportGenerator <|.. FinancialReportGenerator

    ReportFormatter <|.. PDFFormatter
    ReportFormatter <|.. ExcelFormatter
    ReportFormatter <|.. HTMLFormatter

    ReportDelivery <|.. EmailDelivery
    ReportDelivery <|.. DownloadDelivery
    ReportDelivery <|.. CloudDelivery

    ReportSystem --> ReportFactory
    ReportSystem --> ReportGenerator
    ReportSystem --> ReportFormatter
    ReportSystem --> ReportDelivery
