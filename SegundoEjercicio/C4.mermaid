C4Dynamic
title C4 - Flujo de generate_report (Report Management System)

Person(manager, "Gerente/Analista")
Container(reportBackend, "Report Backend", "Python Script/Service", "Generación de reportes")
Component(reportController, "ReportController", "Coordina el flujo")
Component(factory, "ReportFactory", "Selecciona estrategias")
Component(salesGen, "SalesReportGenerator", "Genera contenido de ventas")
Component(pdfFormatter, "PDFFormatter", "Formatea a PDF")
Component(emailDelivery, "EmailDelivery", "Envía por email")
Component(reportHistoryRepo, "ReportHistoryRepository", "Persistencia de historial")

Rel_D(manager, reportBackend, "1) Solicita reporte: tipo='sales', formato='pdf', entrega='email'", "1")
Rel_D(reportBackend, reportController, "2) generate_report('sales', data, 'pdf','email')", "2")
Rel_D(reportController, factory, "3) get_generator('sales')", "3")
Rel_D(factory, salesGen, "4) Retorna SalesReportGenerator", "4")
Rel_D(reportController, salesGen, "5) generate(data)", "5")
Rel_D(reportController, factory, "6) get_formatter('pdf')", "6")
Rel_D(factory, pdfFormatter, "7) Retorna PDFFormatter", "7")
Rel_D(reportController, pdfFormatter, "8) format(content)", "8")
Rel_D(reportController, factory, "9) get_delivery('email')", "9")
Rel_D(factory, emailDelivery, "10) Retorna EmailDelivery", "10")
Rel_D(reportController, emailDelivery, "11) deliver(formattedReport, 'sales','pdf')", "11")
Rel_D(reportController, reportHistoryRepo, "12) Guarda registro del reporte", "12")
